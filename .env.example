# AegisSurg — Autonomous Surgical Safety & Active Complication Interception Platform
# Copy to .env and fill in. Never commit the real .env file.

# GCP Project & Storage
AEGIS_PROJECT_ID=
AEGIS_REGION=us-central1
AEGIS_GCS_BUCKET=aegissurg-cases-${AEGIS_PROJECT_ID}
# Legacy aliases (supported for backwards compatibility):
SURGGRAPH_PROJECT_ID=${AEGIS_PROJECT_ID}
SURGGRAPH_REGION=${AEGIS_REGION}
SURGGRAPH_GCS_BUCKET=${AEGIS_GCS_BUCKET}

# Gemini — gemini-3.5-flash on global Vertex AI endpoint
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global

# Agent Observability — exports real agent traces/metrics/logs to Cloud Trace,
# Cloud Monitoring, and Cloud Logging (tools/observability.py). Off by default.
AEGIS_ENABLE_CLOUD_TELEMETRY=
SURGGRAPH_ENABLE_CLOUD_TELEMETRY=

# FHIR (HAPI public test server — no auth required)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# State service (services/state_service) — local dev instance
STATE_SERVICE_URL=http://127.0.0.1:8080

# Firestore — the Living State Graph's backing store.
# "(default)" is the production database; local dev/tests point at aegissurg-test.
FIRESTORE_DATABASE=aegissurg-test

# Alerting
SLACK_WEBHOOK_URL=

# RAG & Literature Retrieval
EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest

# Three independent live sources merged by RRF (Europe PMC, PubMed, Semantic Scholar)
# Both keys below are optional; each source works unauthenticated and degrades gracefully.
EUTILS_CONTACT_EMAIL=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Model Armor — screens operative notes and prompts before filing to FHIR or LLM
AEGIS_MODEL_ARMOR_TEMPLATE_ID=aegissurg-fhir-outbound
SURGGRAPH_MODEL_ARMOR_TEMPLATE_ID=${AEGIS_MODEL_ARMOR_TEMPLATE_ID}

# Medical Speech Recognition (MedASR)
MEDASR_ENDPOINT_ID=

# Feedback knowledge base (AegisBot Memory Bank integration)
# Set to the deployed synthesis AegisBot subagent's resource name.
AEGIS_FEEDBACK_KB_ENGINE=
SURGGRAPH_FEEDBACK_KB_ENGINE=${AEGIS_FEEDBACK_KB_ENGINE}
